from typing import Tuple, List
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.types import *
from pyspark.sql.functions import col,to_date,year,month,date_trunc,sum
from pyspark.sql.window import Window

def load_music_tracks(spark: SparkSession, path: str) -> DataFrame:
    df=spark.read.csv(path,header=True,inferSchema=True)
    df=df.withColumn("release_date",
                     to_date(col("release_date")))
    return df 

def fill_missing_genre(df: DataFrame) -> DataFrame:
    return (
        df.fillna({
            "genre":"Uncategorized"
        })
    )

def add_release_calendar(df: DataFrame) -> DataFrame:
    df=df.withColumn("release_year",year("release_date"))
    df=df.withColumn("release_month",month("release_date"))
    df=df.withColumn("release_month_start",date_trunc("month","release_date"))
    return df

def unique_published_artists(df: DataFrame) -> list:
    df=df.filter(col("status")=="Published")
    df=df.select("artist_name").distinct()
    df=df.sort(col("artist_name").asc()).collect()
    res=[]
    for i in df:
        res.append(i["artist_name"])
    return res

def top_n_genres_by_streams(df: DataFrame, n: int) -> DataFrame:
    df=df.filter(col("status")=="Published")
    df=(df.groupBy("genre")
        .agg(sum(col("stream_count")).alias("total_streams"))
        .sort(col("total_streams").desc(),col("genre").asc())).limit(n)
    return df

