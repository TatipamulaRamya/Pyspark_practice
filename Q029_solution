from typing import Tuple
from pyspark.sql import SparkSession, DataFrame
from pyspark.sql.functions import col,to_timestamp,unix_timestamp,when,sum,avg,count

def load_delivery_trips(spark: SparkSession, path: str) -> DataFrame:
    df=spark.read.csv(path,header=True,inferSchema=True)
    df=(
        df.withColumn("dispatch_ts",to_timestamp(col("dispatch_ts"),"yyyy-MM-dd HH:mm:ss"))
        .withColumn("promised_ts",to_timestamp(col("promised_ts"),"yyyy-MM-dd HH:mm:ss"))
        .withColumn("actual_ts",to_timestamp(col("actual_ts"),"yyyy-MM-dd HH:mm:ss"))
        .withColumn("distance_km",col("distance_km").cast("double"))
        .withColumn("fare_amount",col("fare_amount").cast("double"))
    )
    return df

def compute_trip_metrics(df: DataFrame) -> DataFrame:
    delay_hours=(unix_timestamp(col("actual_ts"))
                                -unix_timestamp(col("promised_ts")))/3600
    df=(
        df.withColumn(
            "delay_hours",
            when(
                delay_hours<0,0.0
            ).otherwise(delay_hours)
        )
    )
    trip_hours=(unix_timestamp(col("actual_ts"))
                                -unix_timestamp(col("dispatch_ts")))/3600
    df=(
        df.withColumn(
            "trip_hours",
            when(
                trip_hours<0,0.0
            ).otherwise(trip_hours)
        )
    )
    df=(
        df.withColumn(
            "avg_speed_kmph",
            when(
                col("trip_hours")>0,
                (col("distance_km")/col("trip_hours"))
            ).otherwise(0.0)
        )
    )
    return df

def filter_significant_delays(
    df: DataFrame,
    delay_threshold: float,
    min_distance: float
) -> DataFrame:
    df=(
        df.filter(
            (col("delay_hours")>delay_threshold)&
            (col("distance_km")>=min_distance)
        )
    )
    return df

def partner_delay_summary(df: DataFrame) -> DataFrame:
    df=(
        df.filter(col("status")=="Completed")
        .groupBy("partner")
        .agg(
            sum(col("delay_hours")).alias("total_delay_hours"),
            avg(col("fare_amount")).alias("avg_fare"),
            count(col("trip_id")).alias("trip_count")
        )
    )
    return (
        df.select("partner","total_delay_hours","avg_fare","trip_count")
    )

def highest_average_delay_reason(df: DataFrame) -> Tuple[str, float]:
    df=(
        df.filter(
            (col("delay_reason").isNotNull())&
            (col("delay_hours").isNotNull())
        )
        .groupBy("delay_reason")
        .agg(avg(col("delay_hours")).alias("avg_delay_hours"))
        .sort(
            col("avg_delay_hours").desc(),
            col("delay_reason").asc()
        )
        .first()
    )
    if not df:
        return ("",0.0)
    return (
        df["delay_reason"],float(df["avg_delay_hours"])
    )
